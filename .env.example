# Copy this file to .env. Values below work for the local Docker Compose stack.
# Never commit .env.

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# --- MQTT (Mosquitto) ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=telemetry
MQTT_CLIENT_ID=telemetry-hub-api

# --- QuestDB (time-series) ---
QUESTDB_HOST=questdb
QUESTDB_HTTP_PORT=9000
QUESTDB_PG_PORT=8812
QUESTDB_USER=admin
QUESTDB_PASSWORD=quest
QUESTDB_DATABASE=qdb

# --- PostgreSQL (device registry) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telemetry_hub
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry

# --- S3 (RustFS locally, AWS S3 in the cloud) ---
# For real AWS: leave S3_SERVICE_URL empty, set S3_FORCE_PATH_STYLE=false
# and use your own region, bucket and keys.
S3_SERVICE_URL=http://rustfs:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=telemetry-archive
S3_ACCESS_KEY=telemetryhub
S3_SECRET_KEY=telemetryhub-secret
S3_API_PORT=9100
S3_CONSOLE_PORT=9101

# --- Archiving job ---
ARCHIVE_INTERVAL_SECONDS=60
ARCHIVE_WINDOW_MINUTES=5
ARCHIVE_GRACE_SECONDS=10

# --- Simulator ---
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_INTERVAL_MS=1000
